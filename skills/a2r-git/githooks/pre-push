#!/bin/sh
# A2R. Las ramas del cliente no reciben push directo. Mira la rama de destino,
# no la local, asi que tambien caza git push origin develop:main.
# Y donde se pida, el build completo antes de subir.

conf="$(git rev-parse --git-dir 2>/dev/null)/a2r.conf"
[ -f "$conf" ] && . "$conf"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  for protegida in ${RAMAS_PROTEGIDAS-main master releases}; do
    [ "$remote_ref" = "refs/heads/$protegida" ] || continue
    echo "No hay push directo a $protegida. Abre una pull request."
    exit 1
  done
done

# El pre-commit ya ha pasado tsc y lint, que con nuestras reglas adelantan casi
# todo lo que rompe el build. Casi: el lint no compila. Donde eso no baste, aqui
# se compila de verdad, una vez, antes de subir.
[ "${BUILD_ANTES_PUSH-no}" = si ] || exit 0
[ -f package.json ] && grep -q '"build"' package.json || exit 0

echo "pnpm build"
if ! pnpm build; then
  echo "El build falla. No se sube: arreglalo o deja el commit en local."
  exit 1
fi
