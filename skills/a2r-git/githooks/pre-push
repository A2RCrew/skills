#!/bin/sh
# A2R. Las ramas del cliente no reciben push directo. Mira la rama de destino,
# no la local, asi que tambien caza git push origin develop:main.
# Y donde se pida, las pruebas y el build completo antes de subir.

conf="$(git rev-parse --git-dir 2>/dev/null)/a2r.conf"
[ -f "$conf" ] && . "$conf"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  for protegida in ${RAMAS_PROTEGIDAS-main master releases}; do
    [ "$remote_ref" = "refs/heads/$protegida" ] || continue
    echo "No hay push directo a $protegida. Abre una pull request."
    exit 1
  done
done

# El pre-commit ya ha pasado tsc y lint, que con nuestras reglas adelantan casi
# todo lo que rompe el build. Casi: el lint no compila, y desde luego no ejecuta
# nada. Donde eso no baste, aqui se prueba y se compila de verdad, una vez,
# antes de subir. Primero las pruebas, que fallan mas barato que el build.
[ "${COMPROBAR_ANTES_PUSH-${BUILD_ANTES_PUSH-no}}" = si ] || exit 0
[ -f package.json ] || exit 0

# El "test" que deja npm init por defecto no es una prueba, es un exit 1.
if grep -q '"test"' package.json && ! grep -q 'no test specified' package.json; then
  echo "pnpm test"
  if ! pnpm test; then
    echo "Las pruebas fallan. No se sube: arreglalo o deja el commit en local."
    exit 1
  fi
fi

if grep -q '"build"' package.json; then
  echo "pnpm build"
  if ! pnpm build; then
    echo "El build falla. No se sube: arreglalo o deja el commit en local."
    exit 1
  fi
fi
